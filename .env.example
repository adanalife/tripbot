ENV="development"
CHANNEL_NAME=""
BOT_USERNAME=""
READ_ONLY="false"

RUN_DIR=""

# Twitch app credentials. Only the client ID is read here — EventSub sends it in
# its handshake. OAuth consent and token refresh belong to the platform-gateway,
# which holds the client secret. In cluster, ESO pulls this from SSM Parameter
# Store (/k8s/tripbot/twitch-creds).
TWITCH_CLIENT_ID=""

GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_APPS_PROJECT_ID=""
GOOGLE_MAPS_API_KEY=""

DATABASE_HOST=""
DATABASE_PASS=""
DATABASE_USER=""
DATABASE_DB=""

SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

DISABLE_TWITCH_WEBHOOKS="false"

TRIPBOT_SERVER_PORT="8080"
# Where the bot reaches playout upstream (the env key keeps the legacy
# VLC_SERVER_HOST name until the coordinated wire-contract rename).
VLC_SERVER_HOST=localhost:8080

OBS_START_STREAMING="false"
